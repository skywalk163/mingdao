{
    "comments": {
        "lineComment": "#",
        "blockComment": ["#", "#"]
    },
    "brackets": [
        ["[", "]"],
        ["(", ")"],
        ["{", "}"]
    ],
    "autoClosingPairs": [
        {
            "open": "[",
            "close": "]"
        },
        {
            "open": "(",
            "close": ")"
        },
        {
            "open": "\"",
            "close": "\""
        }
    ],
    "surroundingPairs": [
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""]
    ],
    "indentationRules": {
        "increaseIndentPattern": ".*[那么|否则|对于|类|接口|定义].*:",
        "decreaseIndentPattern": ".*[跳出|继续|返回]"
    }
}