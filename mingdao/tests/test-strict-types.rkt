#lang racket/base
;; 严格类型检查器测试
;; 测试类型不匹配、if条件检查、算术运算检查、联合类型赋值等

(require rackunit
         "../lang/type-checker.rkt")

;; ============================================================
;; 测试辅助函数
;; ============================================================

(define (test-check name code should-error?)
  (clear-errors!)
  (let ([env (make-type-env)])
    (cond
      [should-error?
       (let/ec k
         (with-handlers ([exn:fail:type? (lambda (e)
                                            (k (void)))])
           (check-program code env)
           (k (lambda ()
                (error 'test-check "~a: 期望抛出异常但没有抛出" name)))))
       (let ([errors (get-type-errors)])
         (when (null? errors)
           (error 'test-check "~a: 期望类型错误但没有记录" name)))]
      [else
       (check-program code env)
       (let ([errors (get-type-errors)])
         (unless (null? errors)
           (error 'test-check "~a: 不应有类型错误但有: ~a" name errors)))])))

(define (test-expr-check name code expected-type env)
  (clear-errors!)
  (let ([actual-type (check-expr code env)])
    (unless (equal? actual-type expected-type)
      (error 'test-check "~a: 期望类型 ~a 但得到 ~a" name expected-type actual-type))))

;; ============================================================
;; 基础类型测试
;; ============================================================

(test-check "整数类型正确"
  '((定义 x 42))
  #f)

(test-check "浮点数类型正确"
  '((定义 x 3.14))
  #f)

(test-check "字符串类型正确"
  '((定义 x "hello"))
  #f)

(test-check "布尔类型正确"
  '((定义 x #t))
  #f)

;; ============================================================
;; 类型不匹配测试
;; ============================================================

(test-check "整数赋值给字符串变量应报错"
  '((定义 x : 字符串 123))
  #t)

(test-check "字符串赋值给整数变量应报错"
  '((定义 x : 整数 "hello"))
  #t)

(test-check "整数赋值给布尔变量应报错"
  '((定义 x : 布尔 42))
  #t)

(test-check "浮点数赋值给整数变量应报错"
  '((定义 x : 整数 3.14))
  #t)

;; ============================================================
;; if 条件检查
;; ============================================================

(test-check "if 条件为整数应报错"
  '((定义 x (if 123 "yes" "no")))
  #t)

(test-check "if 条件为字符串应报错"
  '((定义 x (if "true" "yes" "no")))
  #t)

(test-check "if 条件为布尔应通过"
  '((定义 x (if #t "yes" "no")))
  #f)

(test-check "if 条件为比较运算应通过"
  '((定义 x (if (大于 1 0) "yes" "no")))
  #f)

;; ============================================================
;; 算术运算操作数类型检查
;; ============================================================

(test-check "加法操作数为字符串应报错"
  '((定义 x (加 "a" "b")))
  #t)

(test-check "减法操作数为布尔应报错"
  '((定义 x (减 #t #f)))
  #t)

(test-check "乘法操作数为字符串应报错"
  '((定义 x (乘 "a" 3)))
  #t)

(test-check "除法操作数为整数应通过（整数除法允许）"
  '((定义 x (除 6 2)))
  #f)

(test-check "幂运算操作数为字符串应报错"
  '((定义 x (幂 "a" 2)))
  #t)

(test-check "模运算操作数为字符串应报错"
  '((定义 x (模 5 "a")))
  #t)

;; ============================================================
;; 变量赋值检查
;; ============================================================

(test-check "变量赋值类型匹配应通过"
  '((定义 x : 整数 10)
    (= x 20))
  #f)

(test-check "变量赋值类型不匹配应报错"
  '((定义 x : 整数 "hello")
    (= x 20))
  #t)

;; ============================================================
;; 联合类型赋值测试
;; ============================================================

(test-check "联合类型赋值匹配的第一个类型应通过"
  '((定义 x : (或 整数 字符串) 123))
  #f)

(test-check "联合类型赋值匹配的第二个类型应通过"
  '((定义 x : (或 整数 字符串) "hello"))
  #f)

(test-check "联合类型赋值不匹配应报错"
  '((定义 x : (或 整数 字符串) #t))
  #t)

;; ============================================================
;; 函数定义检查
;; ============================================================

(test-check "函数定义应通过"
  '((定义 (foo x) (返回 x)))
  #f)

;; ============================================================
;; 函数调用参数检查
;; ============================================================

(test-check "函数调用参数数量不匹配应报错"
  '((定义 (foo x y) (返回 x))
    (定义 z (foo 10)))
  #t)

(test-check "函数调用参数类型不匹配应报错"
  '((定义 (foo x) (返回 x))
    (定义 z (foo 10 20)))
  #t)

;; ============================================================
;; 嵌套表达式检查
;; ============================================================

(test-check "嵌套算术运算类型正确应通过"
  '((定义 x (加 (乘 2 3) (除 6 2))))
  #f)

(test-check "嵌套算术运算包含错误类型应报错"
  '((定义 x (加 (乘 2 "a") (除 6 2))))
  #t)

;; ============================================================
;; check-expr 单元测试
;; ============================================================

(let ([env (make-type-env)])
  (type-env-add-var! env 'x (type-base '整数))
  (test-expr-check "check-expr 变量引用"
    'x
    (type-base '整数)
    env))

(let ([env (make-type-env)])
  (test-expr-check "check-expr 整数字面量"
    '42
    (type-base '整数)
    env))

(let ([env (make-type-env)])
  (test-expr-check "check-expr 字符串字面量"
    '"hello"
    (type-base '字符串)
    env))

(let ([env (make-type-env)])
  (test-expr-check "check-expr 布尔字面量"
    '#t
    (type-base '布尔)
    env))

(let ([env (make-type-env)])
  (type-env-add-fn! env 'foo (list (type-base '整数)) (type-base '整数))
  (test-expr-check "check-expr 函数调用"
    '(foo 10)
    (type-base '整数)
    env))

;; ============================================================
;; 错误计数验证
;; ============================================================

(test-check "多个错误应全部记录"
  '((定义 x : 整数 "a")
    (定义 y : 字符串 123)
    (定义 z (if 123 "yes" "no")))
  #t)

;; ============================================================
;; 输出测试结果
;; ============================================================

(displayln "所有严格类型检查测试通过！")