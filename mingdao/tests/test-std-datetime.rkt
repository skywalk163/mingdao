#lang racket
;; 明道标准库测试 - Datetime 模块
(require "../std/datetime.rkt"
         "../lang/test.rkt"
         racket/date)

(测试组 "Datetime 模块 - 日期函数"
  (λ ()
    (测试 "日期/创建 - 基本"
      (λ ()
        (define result (日期/创建 2024 1 15))
        (断言相等 "2024-01-15" result))))

  (λ ()
    (测试 "日期/创建 - 补零"
      (λ ()
        (define result (日期/创建 2024 3 5))
        (断言相等 "2024-03-05" result))))

  (λ ()
    (测试 "日期/年"
      (λ ()
        (define result (日期/年 "2024-03-05"))
        (断言相等 2024 result))))

  (λ ()
    (测试 "日期/月"
      (λ ()
        (define result (日期/月 "2024-03-05"))
        (断言相等 3 result))))

  (λ ()
    (测试 "日期/日"
      (λ ()
        (define result (日期/日 "2024-03-05"))
        (断言相等 5 result))))

  (λ ()
    (测试 "日期/星期"
      (λ ()
        (define result (日期/星期 "2024-03-04"))
        (断言相等 "星期一" result))))

  (λ ()
    (测试 "日期/差 - 同一天"
      (λ ()
        (define result (日期/差 "2024-01-01" "2024-01-01"))
        (断言相等 0 result))))

  (λ ()
    (测试 "日期/差 - 相隔3天"
      (λ ()
        (define result (日期/差 "2024-01-01" "2024-01-04"))
        (断言相等 3 result))))

  (λ ()
    (测试 "日期/差 - 跨月"
      (λ ()
        (define result (日期/差 "2024-01-31" "2024-02-01"))
        (断言相等 1 result))))

  (λ ()
    (测试 "日期/加 - 加0天"
      (λ ()
        (define result (日期/加 "2024-01-01" 0))
        (断言相等 "2024-01-01" result))))

  (λ ()
    (测试 "日期/加 - 加5天"
      (λ ()
        (define result (日期/加 "2024-01-01" 5))
        (断言相等 "2024-01-06" result))))

  (λ ()
    (测试 "日期/加 - 减3天"
      (λ ()
        (define result (日期/加 "2024-01-05" -3))
        (断言相等 "2024-01-02" result))))

  (λ ()
    (测试 "日期/加 - 跨月"
      (λ ()
        (define result (日期/加 "2024-01-28" 5))
        (断言相等 "2024-02-02" result))))
)

(测试组 "Datetime 模块 - 时间函数"
  (λ ()
    (测试 "时间/创建"
      (λ ()
        (define result (时间/创建 9 5 3))
        (断言相等 "09:05:03" result))))

  (λ ()
    (测试 "时间/时"
      (λ ()
        (define result (时间/时 "14:30:45"))
        (断言相等 14 result))))

  (λ ()
    (测试 "时间/分"
      (λ ()
        (define result (时间/分 "14:30:45"))
        (断言相等 30 result))))

  (λ ()
    (测试 "时间/秒"
      (λ ()
        (define result (时间/秒 "14:30:45"))
        (断言相等 45 result))))
)

(测试组 "Datetime 模块 - 日期时间函数"
  (λ ()
    (测试 "日期时间/创建"
      (λ ()
        (define result (日期时间/创建 2024 3 5 9 30 0))
        (断言相等 "2024-03-05 09:30:00" result))))

  (λ ()
    (测试 "日期时间/格式化 - %Y-%m-%d"
      (λ ()
        (define result (日期时间/格式化 "2024-03-05 09:30:00" "%Y年%m月%d日"))
        (断言相等 "2024年03月05日" result))))

  (λ ()
    (测试 "日期时间/格式化 - %H:%M:%S"
      (λ ()
        (define result (日期时间/格式化 "2024-03-05 09:30:00" "%H时%M分%S秒"))
        (断言相等 "09时30分00秒" result))))

  (λ ()
    (测试 "解析日期 - %Y-%m-%d"
      (λ ()
        (define result (解析日期 "2024/03/05" "%Y/%m/%d"))
        (断言相等 "2024-03-05 00:00:00" result))))

  (λ ()
    (测试 "解析日期 - %d/%m/%Y"
      (λ ()
        (define result (解析日期 "05/03/2024" "%d/%m/%Y"))
        (断言相等 "2024-03-05 00:00:00" result))))
)

(测试组 "Datetime 模块 - 时间差/实用"
  (λ ()
    (测试 "时间差/天"
      (λ ()
        (define result (时间差/天 1))
        (断言相等 86400 result))))

  (λ ()
    (测试 "时间差/小时"
      (λ ()
        (define result (时间差/小时 2))
        (断言相等 7200 result))))

  (λ ()
    (测试 "时间差/分钟"
      (λ ()
        (define result (时间差/分钟 5))
        (断言相等 300 result))))

  (λ ()
    (测试 "时间差/秒"
      (λ ()
        (define result (时间差/秒 30))
        (断言相等 30 result))))

  (λ ()
    (测试 "现在时间戳 返回正整数"
      (λ ()
        (define result (现在时间戳))
        (断言测试 (and (integer? result) (> result 0))))))

  (λ ()
    (测试 "时间戳转日期"
      (λ ()
        (define ts (find-seconds 0 0 0 15 1 2024 #f))
        (define result (时间戳转日期 ts))
        (断言相等 "2024-01-15" result))))

  (λ ()
    (测试 "星期几 - 周一=0 (0=周一~6=周日)"
      (λ ()
        (define result (星期几 2024 1 1))
        (断言相等 0 result))))

  (λ ()
    (测试 "天数 - 大月"
      (λ ()
        (define result (天数 2024 1))
        (断言相等 31 result))))

  (λ ()
    (测试 "天数 - 二月平年"
      (λ ()
        (define result (天数 2023 2))
        (断言相等 28 result))))

  (λ ()
    (测试 "天数 - 二月闰年"
      (λ ()
        (define result (天数 2024 2))
        (断言相等 29 result))))

  (λ ()
    (测试 "今天 返回格式 YYYY-MM-DD"
      (λ ()
        (define result (今天))
        (断言测试 (regexp-match? #px"^\\d{4}-\\d{2}-\\d{2}$" result)))))

  (λ ()
    (测试 "现在 返回格式 YYYY-MM-DD HH:MM:SS"
      (λ ()
        (define result (现在))
        (断言测试 (regexp-match? #px"^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$" result)))))
)

(运行测试)