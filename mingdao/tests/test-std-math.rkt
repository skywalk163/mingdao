#lang racket
;; 明道标准库测试 - Math 模块
(require "../std/math.rkt"
         "../lang/test.rkt")

(测试组 "Math 模块 - 三角函数"
  (λ ()
    (测试 "正弦 0"
      (λ ()
        (define result (正弦 0))
        (断言相等 0 result))))

  (λ ()
    (测试 "余弦 0"
      (λ ()
        (define result (余弦 0))
        (断言相等 1 result))))

  (λ ()
    (测试 "圆周率"
      (λ ()
        (断言相等 3.141592653589793 圆周率))))

  (λ ()
    (测试 "自然常数"
      (λ ()
        (断言测试 (> 自然常数 2.71) "e > 2.71")
        (断言测试 (< 自然常数 2.72) "e < 2.72"))))
)

(测试组 "Math 模块 - 对数与指数"
  (λ ()
    (测试 "自然对数 e = 1"
      (λ ()
        (define result (自然对数 自然常数))
        (断言测试 (< (abs (- result 1.0)) 0.001) "ln(e) ≈ 1"))))

  (λ ()
    (测试 "常用对数 10 = 1"
      (λ ()
        (define result (常用对数 10))
        (断言测试 (< (abs (- result 1.0)) 0.001) "log10(10) ≈ 1"))))

  (λ ()
    (测试 "指数 0 = 1"
      (λ ()
        (define result (指数 0))
        (断言相等 1 result))))
)

(测试组 "Math 模块 - 角度转换"
  (λ ()
    (测试 "角度转弧度 180度 = π"
      (λ ()
        (define result (角度转弧度 180))
        (断言测试 (< (abs (- result 圆周率)) 0.001)))))

  (λ ()
    (测试 "弧度转角度 π = 180度"
      (λ ()
        (define result (弧度转角度 圆周率))
        (断言测试 (< (abs (- result 180)) 0.001)))))

  (λ ()
    (测试 "度转弧度 是 角度转弧度 的别名"
      (λ ()
        (断言相等 (度转弧度 90) (角度转弧度 90))))

    (测试 "弧度转度 是 弧度转角度 的别名"
      (λ ()
        (断言相等 (弧度转度 圆周率) (弧度转角度 圆周率)))))
)

(测试组 "Math 模块 - 阶乘和组合"
  (λ ()
    (测试 "阶乘 0 = 1"
      (λ ()
        (define result (阶乘 0))
        (断言相等 1 result))))

  (λ ()
    (测试 "阶乘 1 = 1"
      (λ ()
        (define result (阶乘 1))
        (断言相等 1 result))))

  (λ ()
    (测试 "阶乘 5 = 120"
      (λ ()
        (define result (阶乘 5))
        (断言相等 120 result))))

  (λ ()
    (测试 "阶乘 10 = 3628800"
      (λ ()
        (define result (阶乘 10))
        (断言相等 3628800 result))))

  (λ ()
    (测试 "组合数 C(5,2) = 10"
      (λ ()
        (define result (组合数 5 2))
        (断言相等 10 result))))

  (λ ()
    (测试 "组合数 C(5,0) = 1"
      (λ ()
        (define result (组合数 5 0))
        (断言相等 1 result))))

  (λ ()
    (测试 "组合数 C(5,5) = 1"
      (λ ()
        (define result (组合数 5 5))
        (断言相等 1 result))))

  (λ ()
    (测试 "组合数 C(2,5) = 0 (k > n)"
      (λ ()
        (define result (组合数 2 5))
        (断言相等 0 result))))

  (λ ()
    (测试 "排列数 P(5,2) = 20"
      (λ ()
        (define result (排列数 5 2))
        (断言相等 20 result))))

  (λ ()
    (测试 "排列数 P(5,0) = 1 (数学上 P(n,0)=1)"
      (λ ()
        (define result (排列数 5 0))
        (断言相等 1 result))))
)

(测试组 "Math 模块 - 数论"
  (λ ()
    (测试 "最大公约数 gcd(12,8) = 4"
      (λ ()
        (define result (最大公约数 12 8))
        (断言相等 4 result))))

  (λ ()
    (测试 "最大公约数 gcd(7,13) = 1"
      (λ ()
        (define result (最大公约数 7 13))
        (断言相等 1 result))))

  (λ ()
    (测试 "最小公倍数 lcm(4,6) = 12"
      (λ ()
        (define result (最小公倍数 4 6))
        (断言相等 12 result))))
)

(测试组 "Math 模块 - 取整"
  (λ ()
    (测试 "取符号 正数"
      (λ ()
        (define result (取符号 5))
        (断言相等 1 result))))

  (λ ()
    (测试 "取符号 负数"
      (λ ()
        (define result (取符号 -3))
        (断言相等 -1 result))))

  (λ ()
    (测试 "取符号 0"
      (λ ()
        (define result (取符号 0))
        (断言相等 0 result))))

  (λ ()
    (测试 "取小数部分 3.14"
      (λ ()
        (define result (取小数部分 3.14))
        (断言测试 (< (abs (- result 0.14)) 0.001)))))

  (λ ()
    (测试 "取整数部分 3.14"
      (λ ()
        (define result (取整数部分 3.14))
        (断言相等 3.0 result))))
)

(运行测试)