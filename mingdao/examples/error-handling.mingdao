;; ============================================================
;; error-handling.mingdao — 明道语言错误处理示例
;; 展示 try/catch、报错、断言等错误处理机制
;; ============================================================

;; ------------------------------------------------------------
;; 示例1：除零错误捕获 — 用 try/catch 安全处理
;; ------------------------------------------------------------
打印, "=== 示例1：除零错误捕获 ==="

定义 安全除法 就是函 被除数, 除数：
    尝试：
        打印, (拼接, "正在计算：", 被除数, " ÷ ", 除数)
        返回 被除数 除 除数
    捕获 e 为：
        打印, (拼接, "捕获到错误：", e)
        返回 空值

定义 结果1 就是 安全除法, 10, 2
打印, (拼接, "10 ÷ 2 = ", 结果1)

定义 结果2 就是 安全除法, 10, 0
打印, (拼接, "10 ÷ 0 = ", 结果2)

;; ------------------------------------------------------------
;; 示例2：文件操作错误处理
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例2：文件操作错误处理 ==="

定义 安全读取文件 就是函 路径：
    尝试：
        定义 内容 就是 读取文件, 路径
        打印, (拼接, "成功读取文件：", 路径)
        返回 内容
    捕获 错误：
        打印, (拼接, "读取文件失败：", 错误)
        返回 空值

安全读取文件, "不存在的文件.txt"

;; ------------------------------------------------------------
;; 示例3：自定义错误 — 使用 报错 函数
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例3：自定义错误 ==="

定义 验证年龄 就是函 年龄：
    如果 年龄 小于 0 那么：
        报错, "年龄不能为负数！"
    否则若 年龄 大于 150 那么：
        报错, "年龄超出合理范围！"
    否则：
        打印, (拼接, "年龄验证通过：", 年龄)

;; 测试正常情况
验证年龄, 25

;; 测试异常情况（用 try/catch 包裹以避免程序终止）
尝试：
    验证年龄, 0 减 5
捕获 错误：
    打印, (拼接, "捕获到自定义错误：", 错误)

尝试：
    验证年龄, 200
捕获 错误：
    打印, (拼接, "捕获到自定义错误：", 错误)

;; ------------------------------------------------------------
;; 示例4：嵌套错误捕获 — 多层错误处理
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例4：嵌套错误捕获 ==="

定义 内层函数 就是函 值：
    尝试：
        定义 结果 就是 100 除 值
        打印, (拼接, "内层计算成功：100 ÷ ", 值, " = ", 结果)
        返回 结果
    捕获 错误：
        打印, (拼接, "内层捕获到错误：", 错误)
        报错, "内层处理失败，向上抛出"

定义 外层函数 就是函 值：
    尝试：
        定义 结果 就是 内层函数, 值
        打印, (拼接, "外层收到结果：", 结果)
        返回 结果
    捕获 错误：
        打印, (拼接, "外层捕获到错误：", 错误)
        返回 空值

打印, "--- 测试正常值 ---"
外层函数, 4

打印, "--- 测试除零 ---"
外层函数, 0

打印, "--- 测试字符串 ---"
外层函数, "不是数字"

;; ------------------------------------------------------------
;; 示例5：使用断言进行防御性编程
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例5：断言检查 ==="

定义 计算折扣 就是函 原价, 折扣率：
    ;; 断言确保参数在合理范围内
    断言, 原价 大于 0, "原价必须大于0"
    断言, 折扣率 大于等于 0, "折扣率不能为负数"
    断言, 折扣率 小于等于 1, "折扣率不能超过1"
    定义 折后价 就是 原价 乘 折扣率
    打印, (拼接, "原价：", 原价, " → 折后：", 折后价)
    返回 折后价

;; 正常调用
计算折扣, 100, 0.8

;; 断言失败示例（用 try/catch 包裹）
尝试：
    计算折扣, 0 减 50, 0.5
捕获 错误：
    打印, (拼接, "断言捕获：", 错误)

尝试：
    计算折扣, 100, 1.5
捕获 错误：
    打印, (拼接, "断言捕获：", 错误)

;; ------------------------------------------------------------
;; 示例6：JSON 解析错误处理
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例6：JSON 解析错误处理 ==="

定义 安全JSON解析 就是函 字符串：
    尝试：
        定义 数据 就是 json解析, 字符串
        打印, "JSON 解析成功"
        返回 数据
    捕获 错误：
        打印, (拼接, "JSON 解析失败：", 错误)
        返回 空值

;; 有效的 JSON
安全JSON解析, "{\"name\": \"明道\", \"version\": 1}"

;; 无效的 JSON
安全JSON解析, "{无效的 JSON 格式}"

;; ------------------------------------------------------------
;; 示例7：类型检查与防御
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例7：类型检查 ==="

定义 安全求平方 就是函 输入：
    如果 是整数, 输入 那么：
        定义 结果 就是 输入 乘 输入
        打印, (拼接, 输入, " 的平方是：", 结果)
        返回 结果
    否则若 是浮点数, 输入 那么：
        定义 结果 就是 输入 乘 输入
        打印, (拼接, 输入, " 的平方是：", 结果)
        返回 结果
    否则：
        定义 错误消息 就是 拼接, "输入必须是数字，但得到：", 转字符串, 输入
        报错, 错误消息

尝试：
    安全求平方, 12
捕获 错误：
    打印, (拼接, "错误：", 错误)

尝试：
    安全求平方, "hello"
捕获 错误：
    打印, (拼接, "错误：", 错误)

;; ------------------------------------------------------------
;; 完成
;; ------------------------------------------------------------
打印, ""
打印, "=== 错误处理示例全部完成 ==="