;; ============================================================
;; main.mingdao — 排序算法集成测试主程序
;; 演示：模块导入 → 多种排序算法 → 结果验证
;; ============================================================

导入 "utils.mingdao"
导入 "algorithms.mingdao"

;; ---- 测试数据 ----
定义 测试数组1 就是 列表 64, 34, 25, 12, 22, 11, 90
定义 测试数组2 就是 列表 5, 2, 8, 1, 9, 3, 7, 4, 6, 10
定义 测试数组3 就是 列表 33, 67, 12, 89, 5, 45, 72, 18, 91, 3

;; ============================================================
;; 主程序：依次运行各种排序算法并打印结果
;; ============================================================

打印, "========== 排序算法集成测试 =========="

;; ---- 冒泡排序 ----
打印, ""
打印, "--- 算法1：冒泡排序 ---"
打印数组, "原始：", 测试数组1
定义 冒泡结果 就是 冒泡排序, 测试数组1
打印数组, "结果：", 冒泡结果

;; ---- 插入排序 ----
打印, ""
打印, "--- 算法2：插入排序 ---"
打印数组, "原始：", 测试数组2
定义 插入结果 就是 插入排序, 测试数组2
打印数组, "结果：", 插入结果

;; ---- 选择排序 ----
打印, ""
打印, "--- 算法3：选择排序 ---"
打印数组, "原始：", 测试数组3
定义 选择结果 就是 选择排序, 测试数组3
打印数组, "结果：", 选择结果

;; ---- 比较函数测试 ----
打印, ""
打印, "--- 比较函数 ---"
定义 比较1 就是 比较, 3, 5
打印, (拼接, "比较(3, 5) = ", 比较1)
定义 比较2 就是 比较, 5, 3
打印, (拼接, "比较(5, 3) = ", 比较2)
定义 比较3 就是 比较, 5, 5
打印, (拼接, "比较(5, 5) = ", 比较3)

打印, ""
打印, "========== 测试完成 =========="
