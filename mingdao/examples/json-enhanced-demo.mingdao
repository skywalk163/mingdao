;; JSON 模块增强功能示例
;; 展示新增的中文函数别名

(导入 "std/json.rkt")

打印, "=== JSON 模块增强功能示例 ===\n"

;; 1. 测试新的函数别名
打印, "1. 测试新的函数别名"

定义 json字符串 就是 "{\"name\": \"明道\", \"version\": 1}"

;; 使用旧名
打印, "  使用旧名 json解析："
打印, (json解析, json字符串)

;; 使用新别名
打印, "\n  使用新别名 解析json："
打印, (解析json, json字符串)

打印, "\n2. 生成 JSON"
定义 数据 就是 列表 列表 "name", "明道", 列表 "features", "中文编程", "跨平台", "简洁"

;; 使用新别名
定义 生成的JSON 就是 生成json, 数据
打印, (拼接, "  使用 生成json：", 生成的JSON)

打印, "\n3. 所有可用的 JSON 函数别名："
打印, "  - 解析json / json解析 / json字符串转列表 / json转列表"
打印, "  - 生成json / json生成 / 列表转json字符串 / 列表转json"
打印, "  - json读文件 / json写文件 / 读取json文件 / 写入json文件"

打印, "\n=== 示例完成 ==="
