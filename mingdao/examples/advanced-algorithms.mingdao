;; 示例7：阶乘与组合数学
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例7：阶乘与组合数学 ==="

;; 递归阶乘
定义 递归阶乘 就是函 n：
    如果 n 小于等于 1 那么：
        返回 1
    否则：
        返回 乘 n 递归阶乘(减 n, 1)

对于 i 从 1 到 10：
    打印, (拼接, i, "! = ", 递归阶乘, i)

;; 使用标准库函数
打印, ""
打印, "标准库阶乘："
打印, (拼接, "  15! = ", 阶乘, 15)
打印, (拼接, "  C(10, 3) = ", 组合数, 10, 3)
打印, (拼接, "  P(10, 3) = ", 排列数, 10, 3)

