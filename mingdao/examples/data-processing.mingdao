;; ============================================================
;; data-processing.mingdao — 明道语言数据处理示例
;; 展示 JSON/CSV 数据解析、转换、过滤、映射等处理流程
;; ============================================================

;; ------------------------------------------------------------
;; 示例1：JSON 解析与生成
;; ------------------------------------------------------------
打印, "=== 示例1：JSON 解析与生成 ==="

定义 json字符串 就是 "{\"name\": \"明道\", \"version\": 1, \"features\": [\"中文\", \"简洁\", \"强大\"]}"

;; 将 JSON 字符串解析为数据结构
定义 数据 就是 json解析, json字符串
打印, "解析 JSON 成功"

;; JSON 生成 — 将数据转换回 JSON 字符串
定义 用户列表 就是 列表(哈希("name", "张三", "age", 28, "city", "北京"), 哈希("name", "李四", "age", 35, "city", "上海"), 哈希("name", "王五", "age", 22, "city", "深圳"))

定义 json字符串结果 就是 json生成, 用户列表
打印, "生成的 JSON："
打印, json字符串结果

;; ------------------------------------------------------------
;; 示例2：CSV 解析与生成
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例2：CSV 解析与生成 ==="

定义 csv数据 就是 "姓名,年龄,城市\n张三,28,北京\n李四,35,上海\n王五,22,深圳"

;; 解析 CSV 字符串
定义 行列表 就是 csv解析, csv数据
打印, "CSV 解析结果："
对于每个 行 从 行列表：
    打印, 行

;; 生成 CSV 字符串
定义 新数据 就是 列表(列表("产品", "价格", "库存"), 列表("笔记本", "5999", "100"), 列表("手机", "3999", "200"), 列表("平板", "2999", "150"))

定义 csv字符串结果 就是 csv生成, 新数据
打印, ""
打印, "生成的 CSV："
打印, csv字符串结果

;; ------------------------------------------------------------
;; 示例3：数据映射 — 使用 映射 函数
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例3：数据映射 ==="

定义 原始数字 就是 列表 1, 2, 3, 4, 5

;; 定义转换函数
定义 翻倍 就是函 x：
    返回 x 乘 2

定义 翻倍后 就是 映射, 翻倍, 原始数字
打印, (拼接, "原始数字：", 原始数字)
打印, (拼接, "翻倍后：", 翻倍后)

;; 字符串转换
定义 温度列表 就是 列表 0, 10, 20, 30, 100
定义 转摄氏描述 就是函 t：
    返回 拼接, "温度：", t, "°C"

定义 描述列表 就是 映射, 转摄氏描述, 温度列表
对于每个 描述 从 描述列表：
    打印, 描述

;; ------------------------------------------------------------
;; 示例4：数据过滤 — 使用 过滤 函数
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例4：数据过滤 ==="

定义 数字集 就是 列表 15, 23, 8, 42, 4, 16, 7, 31

定义 是偶数 就是函 x：
    返回 x 模 2 等于 0

定义 大10 就是函 x：
    返回 x 大于 10

定义 偶数列表 就是 过滤, 是偶数, 数字集
打印, (拼接, "所有数字：", 数字集)
打印, (拼接, "偶数：", 偶数列表)

定义 大数列表 就是 过滤, 大10, 数字集
打印, (拼接, "大于10的数：", 大数列表)

;; 链式处理：过滤后映射
定义 大数翻倍 就是 映射, 翻倍, (过滤, 大10, 数字集)
打印, (拼接, "大于10的数翻倍：", 大数翻倍)

;; ------------------------------------------------------------
;; 示例5：排序与统计
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例5：排序与统计 ==="

定义 成绩列表 就是 列表 88, 95, 72, 63, 90, 78, 85

;; 排序（默认升序）
定义 升序成绩 就是 排序, 成绩列表
打印, (拼接, "成绩升序：", 升序成绩)

;; 反转实现降序
定义 降序成绩 就是 反转, 排序, 成绩列表
打印, (拼接, "成绩降序：", 降序成绩)

;; 统计求和与平均值
定义 总分 就是 求和, 成绩列表
定义 平均分 就是 总分 除 长度(成绩列表)
打印, (拼接, "总分：", 总分)
打印, (拼接, "平均分：", 平均分)

;; 最大值与最小值
定义 最高分 就是 最大值, 成绩列表
定义 最低分 就是 最小值, 成绩列表
打印, (拼接, "最高分：", 最高分)
打印, (拼接, "最低分：", 最低分)

;; ------------------------------------------------------------
;; 示例6：综合数据处理管道
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例6：综合数据处理管道 ==="

;; 模拟销售数据
定义 销售原始数据 就是 csv解析, "产品,类别,金额,日期\n笔记本电脑,电子,5999,2024-01-15\n手机,电子,3999,2024-01-16\n面包,食品,15,2024-01-15\n牛奶,食品,28,2024-01-16\n平板,电子,2999,2024-01-17"

打印, "原始销售数据："
对于每个 行 从 销售原始数据：
    打印, 行

;; 提取金额列（从第三列，索引2）
定义 提取金额 就是函 行：
    返回 字符串转数字, 索引, 行, 2

定义 金额列表 就是 映射, 提取金额, (去掉首个, 销售原始数据)

;; 计算总销售额
定义 总销售额 就是 求和, 金额列表
打印, ""
打印, (拼接, "总销售额：", 总销售额)

;; 分类汇总
定义 电子类金额 就是 列表(5999, 3999, 2999)
定义 食品类金额 就是 列表(15, 28)

定义 电子类销售额 就是 求和, 电子类金额
定义 食品类销售额 就是 求和, 食品类金额
定义 电子类数量 就是 长度, 电子类金额
定义 食品类数量 就是 长度, 食品类金额
打印, (拼接, "电子类销售总额：", 电子类销售额)
打印, (拼接, "食品类销售总额：", 食品类销售额)
打印, (拼接, "电子类平均单价：", 电子类销售额 除 电子类数量)
打印, (拼接, "食品类平均单价：", 食品类销售额 除 食品类数量)

;; ------------------------------------------------------------
;; 示例7：去重与拉链操作
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例7：去重与拉链 ==="

定义 带重复列表 就是 列表 1, 2, 2, 3, 3, 3, 4, 5, 5
定义 去重后 就是 去重, 带重复列表
打印, (拼接, "去重前：", 带重复列表)
打印, (拼接, "去重后：", 去重后)

;; 拉链（zip）— 将两个列表配对
定义 名称列表 就是 列表 "张三", "李四", "王五"
定义 分数列表 就是 列表 88, 95, 72

定义 配对结果 就是 拉链, 名称列表, 分数列表
打印, "姓名与分数配对："
对于每个 对 从 配对结果：
    打印, 对

;; 扁平化嵌套列表
定义 嵌套列表 就是 列表(列表 1, 2, 列表 3, 4, 列表 5, 6)
定义 扁平后 就是 扁平, 嵌套列表
打印, (拼接, "嵌套列表：", 嵌套列表)
打印, (拼接, "扁平化后：", 扁平后)

;; ------------------------------------------------------------
;; 完成
;; ------------------------------------------------------------
打印, ""
打印, "=== 数据处理示例全部完成 ==="