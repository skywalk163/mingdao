;; ============================================================
;; 模块：drawing.mingdao — 所有绘制函数
;; 功能：玩家、敌机、子弹、爆炸和UI的绘制
;; 依赖：需要先加载 constants.mingdao, state.mingdao
;; 调试：每个函数独立测试，用 检查 验证坐标值
;; ============================================================

;; ---- 玩家绘制 ----
定义 绘制玩家 就是函 _：
    定义 cx 就是 玩家x 加 玩家宽 除 2
    定义 cy 就是 玩家y 加 玩家高 除 2
    定义 hh 就是 玩家高 除 2
    画实心三角形, cx, 玩家y, 玩家x, 玩家y 加 hh, 玩家x 加 玩家宽, 玩家y 加 hh, 0, 255, 120
    画实心矩形, 玩家x 加 14, 玩家y 加 hh, 4, hh, 0, 200, 80
    画实心矩形, 玩家x 加 22, 玩家y 加 hh, 4, hh, 0, 200, 80
    如果 武器等级 大于 1 那么：
        画实心矩形, 玩家x 加 8, 玩家y 加 hh 减 4, 4, 12, 100, 255, 0
        画实心矩形, 玩家x 加 28, 玩家y 加 hh 减 4, 4, 12, 100, 255, 0
    如果 无敌计时 大于 0 那么：
        画圆形, cx, cy, 28, 255, 255, 100

;; ---- 敌机绘制 ----
定义 绘制敌机 就是函 _：
    对于 i 从 0 到 敌机列表, 长度：
        定义 敌机 就是 索引, 敌机列表, i
        定义 ex 就是 敌机, 0, 索引
        定义 ey 就是 敌机, 1, 索引
        定义 类型 就是 敌机, 3, 索引
        定义 ew 就是 敌机, 6, 索引
        定义 eh 就是 敌机, 7, 索引
        定义 ehw 就是 ew 除 2
        定义 ehh 就是 eh 除 2
        如果 类型 等于 0 那么：
            画实心矩形, ex, ey, ew, eh, 255, 50, 50
            画矩形, ex, ey, ew, eh, 200, 30, 30
        否则若 类型 等于 1 那么：
            画实心三角形, ex 加 ehw, ey, ex, ey 加 eh, ex 加 ew, ey 加 eh, 255, 150, 0
            画三角形, ex 加 ehw, ey, ex, ey 加 eh, ex 加 ew, ey 加 eh, 200, 120, 0
        否则：
            画实心矩形, ex, ey, ew, eh, 180, 0, 180
            画矩形, ex, ey, ew, eh, 150, 0, 120
            画实心圆形, ex 加 ehw, ey 加 10, 8, 200, 50, 200

;; ---- 子弹绘制 ----
定义 绘制子弹 就是函 _：
    对于 i 从 0 到 子弹列表, 长度：
        定义 子弹 就是 索引, 子弹列表, i
        定义 bx 就是 子弹, 0, 索引
        定义 by 就是 子弹, 1, 索引
        定义 伤害 就是 子弹, 3, 索引
        如果 伤害 大于 1 那么：
            画实心矩形, bx 减 2, by, 10, 16, 0, 200, 255
            画实心矩形, bx, by 加 2, 6, 12, 100, 255, 255
        否则：
            画实心矩形, bx, by, 6, 14, 0, 200, 255
            画实心矩形, bx 加 1, by 加 2, 4, 10, 100, 255, 255

;; ---- 敌弹绘制 ----
定义 绘制敌弹 就是函 _：
    对于 i 从 0 到 敌弹列表, 长度：
        定义 弹 就是 索引, 敌弹列表, i
        定义 bx 就是 弹, 0, 索引
        定义 by 就是 弹, 1, 索引
        画实心圆形, bx, by, 5, 255, 200, 0
        画圆形, bx, by, 5, 255, 255, 0

;; ---- 爆炸绘制 ----
定义 绘制爆炸 就是函 _：
    对于 i 从 0 到 爆炸列表, 长度：
        定义 爆 就是 索引, 爆炸列表, i
        定义 bx 就是 爆, 0, 索引
        定义 by 就是 爆, 1, 索引
        定义 bt 就是 爆, 2, 索引
        定义 bm 就是 爆, 3, 索引
        定义 r 就是 bm 减 bt 乘 3
        定义 透明度 就是 bt 乘 255 除 bm
        画实心圆形, bx, by, r, 255, 透明度, 0
        画实心圆形, bx, by, r 除 2, 255, 255, 透明度

;; ---- UI 绘制 ----
定义 绘制UI 就是函 _：
    画文本, 10, 10, ("分数：", 分数, "  生命：", 玩家生命, "  武器：Lv", 武器等级, 拼接), 0, 255, 200, 22
    如果 游戏结束 等于 真值 那么：
        画文本, 200, 250, "【游戏结束】", 255, 50, 50, 40
        画文本, 210, 310, ("最终分数：", 分数, 拼接), 255, 200, 0, 28
        画文本, 250, 360, "按 R 重新开始  ESC 关闭窗口", 150, 150, 150, 18

;; ---- 主绘制入口 ----
定义 绘制 就是函 _：
    清除背景, 10, 10, 30
    画实心矩形, 0, 屏幕高 减 40, 屏幕宽, 40, 5, 5, 20
    对于 i 从 0 到 30：
        定义 sx 就是 i 乘 27
        定义 sy 就是 帧时间 乘 100 加 i 乘 19
        画实心圆形, sx, (sy 模 屏幕高), 1, 50, 50, 80
    空值, 绘制子弹
    空值, 绘制敌弹
    空值, 绘制敌机
    空值, 绘制爆炸
    空值, 绘制玩家
    空值, 绘制UI