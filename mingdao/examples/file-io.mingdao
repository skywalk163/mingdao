;; ============================================================
;; file-io.mingdao — 明道语言文件读写操作示例
;; 展示文件的读取、写入、追加、文件信息查询等常用操作
;; ============================================================

;; ------------------------------------------------------------
;; 示例1：写入文件 — 将字符串写入文件
;; ------------------------------------------------------------
打印, "=== 示例1：写入文件 ==="

;; 定义测试文件路径（使用临时目录）
定义 文件名 就是 "mingdao-io-test.txt"

;; 写入一段文本到文件（若文件已存在则覆盖）
写入文件, 文件名, "你好，明道！\n这是第一行内容。\n这是第二行内容。"

打印, (拼接, "文件已写入：", 文件名)

;; ------------------------------------------------------------
;; 示例2：读取文件 — 将整个文件读入字符串
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例2：读取文件 ==="

定义 内容 就是 读取文件, 文件名
打印, "文件内容："
打印, 内容

;; ------------------------------------------------------------
;; 示例3：检查文件信息 — 使用 os 模块功能
;; ------------------------------------------------------------
打印, "=== 示例3：文件信息查询 ==="

定义 是否存在 就是 文件存在, 文件名
打印, (拼接, "文件是否存在：", 是否存在)

定义 文件大 就是 文件大小, 文件名
打印, (拼接, "文件大小（字节）：", 文件大)

定义 是否为文件 就是 是文件, 文件名
打印, (拼接, "是否为文件：", 是否为文件)

;; ------------------------------------------------------------
;; 示例4：追加写入 — 在文件末尾追加新内容
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例4：追加写入 ==="

;; 使用 io 模块的追加模式写入
定义 端口 就是 io/打开文件, 文件名, "a"
io/写入行, 端口, "这是追加的第三行。"
io/写入行, 端口, "这是追加的第四行。"
io/关闭, 端口

;; 读取并验证追加结果
定义 新内容 就是 读取文件, 文件名
打印, "追加后的文件内容："
打印, 新内容

;; ------------------------------------------------------------
;; 示例5：逐行读取 — 处理大文件
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例5：逐行读取 ==="

定义 输入端口 就是 io/打开文件, 文件名, "r"
定义 行号 就是 1

;; 逐行读取并打印
当满足 行号 小于等于 4 那么：
    定义 行 就是 io/读取行, 输入端口
    如果 行 那么：
        打印, (拼接, "第", 行号, "行：", 行)
        赋值 行号 为 行号 加 1
    否则：
        跳出

io/关闭, 输入端口

;; ------------------------------------------------------------
;; 示例6：复制文件 — 综合应用
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例6：复制文件 ==="

定义 备份名 就是 "mingdao-io-test-backup.txt"

定义 源内容 就是 读取文件, 文件名
写入文件, 备份名, 源内容

打印, (拼接, "已复制到：", 备份名)

定义 备份内容 就是 读取文件, 备份名
如果 备份内容 等于 内容 那么：
    打印, "文件复制验证通过 ✅"
否则：
    打印, "文件复制验证失败 ❌"

;; ------------------------------------------------------------
;; 示例7：写入数字列表 — 结构化数据写入
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例7：写入数字列表 ==="

定义 数字文件 就是 "numbers.txt"
定义 数字列表 就是 列表 10, 20, 30, 40, 50

;; 将每个数字写入一行
定义 输出端口 就是 io/打开文件, 数字文件, "w"
对于每个 数字 从 数字列表：
    io/写入行, 输出端口, 数字转字符串, 数字
io/关闭, 输出端口

;; 读取并显示
定义 数字内容 就是 读取文件, 数字文件
打印, "数字文件内容："
打印, 数字内容

;; ------------------------------------------------------------
;; 清理 — 删除临时文件
;; ------------------------------------------------------------
打印, ""
打印, "=== 清理临时文件 ==="

删除文件, 文件名
删除文件, 备份名
删除文件, 数字文件

打印, "所有临时文件已清理 ✅"
打印, "文件 I/O 示例全部完成！"