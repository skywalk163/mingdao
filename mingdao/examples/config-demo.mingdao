;; ============================================================
;; config-demo.mingdao — 明道语言配置解析示例
;; 展示 INI 风格配置文件的读取、写入和查询操作
;; ============================================================

;; ------------------------------------------------------------
;; 示例1：创建配置并读取字符串
;; ------------------------------------------------------------
打印, "=== 示例1：创建配置并读取字符串 ==="

;; 创建一个配置对象
定义 配置 就是 配置/创建

;; 从字符串读取配置
定义 ini内容 就是 "
[server]
host = localhost
port = 8080
timeout = 30
debug = true

[database]
dbname = myapp
user = admin
password = secret123
pool_size = 10

[logging]
level = INFO
file = /var/log/app.log
"

配置/读取字符串, 配置, ini内容
打印, "配置已从字符串加载 ✅"

;; 获取配置项
定义 服务器地址 就是 配置/获取, 配置, "server", "host"
定义 服务器端口 就是 配置/获取整数, 配置, "server", "port"
定义 超时时间 就是 配置/获取整数, 配置, "server", "timeout"
定义 调试模式 就是 配置/获取布尔, 配置, "server", "debug"

打印, (拼接, "服务器地址：", 服务器地址)
打印, (拼接, "服务器端口：", 服务器端口)
打印, (拼接, "超时时间（秒）：", 超时时间)
打印, (拼接, "调试模式：", 调试模式)

;; ------------------------------------------------------------
;; 示例2：查询配置节和选项
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例2：查询配置节和选项 ==="

;; 获取所有节
定义 节列表 就是 配置/节列表, 配置
打印, "所有配置节："
对于每个 节 从 节列表：
    打印, (拼接, "  [", 节, "]")
    定义 选项列 就是 配置/选项列表, 配置, 节
    对于每个 选项 从 选项列：
        定义 值 就是 配置/获取, 配置, 节, 选项
        打印, (拼接, "    ", 选项, " = ", 值)

;; 检查节和选项是否存在
定义 有server 就是 配置/有节, 配置, "server"
定义 有database 就是 配置/有节, 配置, "database"
定义 有redis 就是 配置/有节, 配置, "redis"

打印, (拼接, "有 [server] 节：", 有server)
打印, (拼接, "有 [database] 节：", 有database)
打印, (拼接, "有 [redis] 节：", 有redis)

定义 有host 就是 配置/有选项, 配置, "server", "host"
定义 有nonexist 就是 配置/有选项, 配置, "server", "nonexist"
打印, (拼接, "有 host 选项：", 有host)
打印, (拼接, "有 nonexist 选项：", 有nonexist)

;; ------------------------------------------------------------
;; 示例3：获取不同类型配置值
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例3：获取不同类型配置值 ==="

定义 数据库名 就是 配置/获取, 配置, "database", "dbname"
定义 数据库用户 就是 配置/获取, 配置, "database", "user"
定义 连接池大小 就是 配置/获取整数, 配置, "database", "pool_size"

打印, (拼接, "数据库名：", 数据库名)
打印, (拼接, "用户：", 数据库用户)
打印, (拼接, "连接池大小：", 连接池大小)

;; 获取浮点数
定义 ini带浮点 就是 "
[limits]
max_memory = 1024.5
disk_quota = 50.8
"

配置/读取字符串, 配置, ini带浮点
定义 最大内存 就是 配置/获取浮点, 配置, "limits", "max_memory"
定义 硬盘配额 就是 配置/获取浮点, 配置, "limits", "disk_quota"
打印, (拼接, "最大内存（GB）：", 最大内存)
打印, (拼接, "硬盘配额（GB）：", 硬盘配额)

;; ------------------------------------------------------------
;; 示例4：修改和添加配置
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例4：修改和添加配置 ==="

;; 修改现有配置项
配置/设置, 配置, "server", "port", "9090"
配置/设置, 配置, "server", "host", "0.0.0.0"

;; 添加新节和新选项
配置/添加节, 配置, "cache"
配置/设置, 配置, "cache", "type", "redis"
配置/设置, 配置, "cache", "ttl", "3600"
配置/设置, 配置, "cache", "max_entries", "10000"

打印, "修改后的 [server] 节："
打印, (拼接, "  host = ", 配置/获取, 配置, "server", "host")
打印, (拼接, "  port = ", 配置/获取整数, 配置, "server", "port")

打印, "新增的 [cache] 节："
打印, (拼接, "  type = ", 配置/获取, 配置, "cache", "type")
打印, (拼接, "  ttl = ", 配置/获取整数, 配置, "cache", "ttl")
打印, (拼接, "  max_entries = ", 配置/获取整数, 配置, "cache", "max_entries")

;; ------------------------------------------------------------
;; 示例5：删除配置项和节
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例5：删除配置项和节 ==="

打印, (拼接, "删除前是否有 password 选项：", 配置/有选项, 配置, "database", "password")

;; 删除配置项
配置/删除, 配置, "database", "password"
打印, (拼接, "删除后是否有 password 选项：", 配置/有选项, 配置, "database", "password")

;; 删除整个节
打印, (拼接, "删除前是否有 [limits] 节：", 配置/有节, 配置, "limits")
配置/移除节, 配置, "limits"
打印, (拼接, "删除后是否有 [limits] 节：", 配置/有节, 配置, "limits")

;; ------------------------------------------------------------
;; 示例6：将配置转为字典
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例6：配置转字典 ==="

定义 配置字典 就是 配置/节转字典, 配置
打印, "配置字典（[server] 节）："

;; 获取服务器节字典
定义 服务器配置 就是 配置/节转字典, 配置, "server"
打印, (拼接, "[server] 节内容：", 服务器配置)

;; ------------------------------------------------------------
;; 示例7：写入配置文件
;; ------------------------------------------------------------
打印, ""
打印, "=== 示例7：写入配置文件 ==="

定义 配置文件路径 就是 "app-config.ini"

;; 将配置写入文件
定义 输出端口 就是 io/打开文件, 配置文件路径, "w"
配置/写入, 配置, 输出端口
io/关闭, 输出端口

打印, (拼接, "配置已写入：", 配置文件路径)

;; 从文件读取验证
定义 验证配置 就是 配置/创建
配置/读取文件, 验证配置, 配置文件路径

定义 验证host 就是 配置/获取, 验证配置, "server", "host"
定义 验证port 就是 配置/获取整数, 验证配置, "server", "port"
定义 验证cache 就是 配置/获取, 验证配置, "cache", "type"

如果 验证host 等于 "0.0.0.0" 那么：
    打印, (拼接, "host 验证通过 ✅：", 验证host)
否则：
    打印, "host 验证失败 ❌"

打印, (拼接, "cache type：", 验证cache)

;; 清理文件
删除文件, 配置文件路径
打印, "临时配置文件已清理 ✅"

;; ------------------------------------------------------------
;; 完成
;; ------------------------------------------------------------
打印, ""
打印, "=== 配置解析示例全部完成 ==="